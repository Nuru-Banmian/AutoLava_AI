{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "files": {
    "includes": [
      "src/components/AgentPanel.tsx",
      "src/components/AgentPanel.test.tsx",
      "src/navigation/agent-actions.ts",
      "src/navigation/agent-actions.test.ts",
      "scripts/validate-agent-release-manifest.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
