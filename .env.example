# Copy this file to .env and replace every change-me value before deployment.
# Compose stores the application database and automatic backups in its persistent /data volume.
AUTOLAVA_JWT_SECRET=change-me-use-a-long-random-secret
AUTOLAVA_COOKIE_SECURE=true
AUTOLAVA_WEATHER_MAX_INFLIGHT=4
AUTOLAVA_BOOTSTRAP_USERNAME=change-me-admin
AUTOLAVA_BOOTSTRAP_PASSWORD=change-me-use-a-strong-password

# AI chat: fill all three for your selected Bailian region/business space.
# Base URL is the OpenAI-compatible /v1 endpoint; no model/resource is assumed.
AUTOLAVA_AGENT_CHAT_BASE_URL=
AUTOLAVA_AGENT_CHAT_API_KEY=
AUTOLAVA_AGENT_CHAT_MODEL=
# Qwen3 hybrid models: disable hidden reasoning to fit the bounded chat deadline.
# Set true explicitly when deeper reasoning is wanted.
AUTOLAVA_AGENT_CHAT_ENABLE_THINKING=false
# Configure each workload independently; no paid resources are selected implicitly.
AUTOLAVA_AGENT_MEMORY_BASE_URL=
AUTOLAVA_AGENT_MEMORY_API_KEY=
AUTOLAVA_AGENT_MEMORY_MODEL=
# Independent from chat; omit to use the memory model's own default.
# AUTOLAVA_AGENT_MEMORY_ENABLE_THINKING=false
AUTOLAVA_AGENT_MEMORY_MAX_CALLS=2
AUTOLAVA_AGENT_MEMORY_TIMEOUT_SECONDS=30
AUTOLAVA_AGENT_MEMORY_CONTEXT_CHARS=18000
AUTOLAVA_AGENT_MEMORY_OUTPUT_CHARS=4000
AUTOLAVA_AGENT_MEMORY_OUTPUT_TOKENS=8192
AUTOLAVA_AGENT_EMBEDDING_BASE_URL=
AUTOLAVA_AGENT_EMBEDDING_API_KEY=
AUTOLAVA_AGENT_EMBEDDING_MODEL=
# Set the chosen embedding dimension only when that workload is configured.
# AUTOLAVA_AGENT_EMBEDDING_DIMENSIONS=
AUTOLAVA_AGENT_MAX_CALLS=2
# Total model attempts (including retries) and executed tools per conversation turn.
AUTOLAVA_AGENT_MAX_STEPS=8
AUTOLAVA_AGENT_MAX_TOOL_CALLS=8
AUTOLAVA_AGENT_TIMEOUT_SECONDS=60
AUTOLAVA_AGENT_CONTEXT_CHARS=48000
AUTOLAVA_AGENT_OUTPUT_CHARS=16000
AUTOLAVA_AGENT_OUTPUT_TOKENS=4096
# Vector retrieval is opt-in. Choose either a persistent local path (ONE process)
# or a standalone Qdrant URL. Configure Embedding above before enabling.
# AUTOLAVA_AGENT_VECTOR_PATH=../.autolava-local/qdrant
AUTOLAVA_AGENT_VECTOR_URL=
AUTOLAVA_AGENT_VECTOR_API_KEY=
AUTOLAVA_AGENT_VECTOR_INDEX_VERSION=1
AUTOLAVA_AGENT_EMBEDDING_TIMEOUT_SECONDS=10
AUTOLAVA_AGENT_INDEX_MAX_ATTEMPTS=3
AUTOLAVA_AGENT_INDEX_POLL_SECONDS=2
