# Copy this file to .env and replace every change-me value before deployment.
# Compose stores the application database and automatic backups in its persistent /data volume.
AUTOLAVA_JWT_SECRET=change-me-use-a-long-random-secret
AUTOLAVA_COOKIE_SECURE=true
AUTOLAVA_BOOTSTRAP_USERNAME=change-me-admin
AUTOLAVA_BOOTSTRAP_PASSWORD=change-me-use-a-strong-password

# Model provider profile. Keep the API key only in this ignored root .env or a deployment Secret.
# Use fake only for local/CI verification; production providers use openai_compatible.
AUTOLAVA_MODEL_ADAPTER=openai_compatible
AUTOLAVA_MODEL_PROVIDER=primary
AUTOLAVA_MODEL_BASE_URL=
AUTOLAVA_MODEL_ID=
AUTOLAVA_MODEL_STRUCTURED_OUTPUT_METHOD=json_schema
AUTOLAVA_MODEL_THINKING_PARAMETERS={}
AUTOLAVA_MODEL_INPUT_COST_PER_MILLION=0
AUTOLAVA_MODEL_OUTPUT_COST_PER_MILLION=0
AUTOLAVA_MODEL_API_KEY=

# Optional fallback profile. Leave all three connection fields empty to disable fallback.
AUTOLAVA_FALLBACK_MODEL_PROVIDER=fallback
AUTOLAVA_FALLBACK_MODEL_BASE_URL=
AUTOLAVA_FALLBACK_MODEL_ID=
AUTOLAVA_FALLBACK_MODEL_STRUCTURED_OUTPUT_METHOD=json_schema
AUTOLAVA_FALLBACK_MODEL_THINKING_PARAMETERS={}
AUTOLAVA_FALLBACK_MODEL_INPUT_COST_PER_MILLION=0
AUTOLAVA_FALLBACK_MODEL_OUTPUT_COST_PER_MILLION=0
AUTOLAVA_FALLBACK_MODEL_API_KEY=
