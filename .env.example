# Copy this file to .env and replace every change-me value before deployment.
# Compose stores the application database and automatic backups in its persistent /data volume.
AUTOLAVA_JWT_SECRET=change-me-use-a-long-random-secret
AUTOLAVA_COOKIE_SECURE=true
AUTOLAVA_WEATHER_MAX_INFLIGHT=4
AUTOLAVA_BOOTSTRAP_USERNAME=change-me-admin
AUTOLAVA_BOOTSTRAP_PASSWORD=change-me-use-a-strong-password

# AI chat: fill all three for your selected Bailian region/business space.
# Base URL is the OpenAI-compatible /v1 endpoint; no model/resource is assumed.
AUTOLAVA_AGENT_CHAT_BASE_URL=
AUTOLAVA_AGENT_CHAT_API_KEY=
AUTOLAVA_AGENT_CHAT_MODEL=
# Separate future workloads; T2 does not call memory/embedding services.
AUTOLAVA_AGENT_MEMORY_BASE_URL=
AUTOLAVA_AGENT_MEMORY_API_KEY=
AUTOLAVA_AGENT_MEMORY_MODEL=
AUTOLAVA_AGENT_EMBEDDING_BASE_URL=
AUTOLAVA_AGENT_EMBEDDING_API_KEY=
AUTOLAVA_AGENT_EMBEDDING_MODEL=
# Set the chosen embedding dimension only when that workload is configured.
# AUTOLAVA_AGENT_EMBEDDING_DIMENSIONS=
AUTOLAVA_AGENT_MAX_CALLS=2
AUTOLAVA_AGENT_TIMEOUT_SECONDS=60
AUTOLAVA_AGENT_CONTEXT_CHARS=24000
AUTOLAVA_AGENT_OUTPUT_CHARS=16000
AUTOLAVA_AGENT_OUTPUT_TOKENS=4096
